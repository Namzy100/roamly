{
  "name": "roamly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration:osm": "vitest run --config vitest.integration.config.ts test/integration/osm.integration.test.ts",
    "test:integration:routing": "vitest run --config vitest.integration.config.ts test/integration/routing.integration.test.ts",
    "test:integration:ai:gemini": "vitest run --config vitest.integration.config.ts test/integration/ai-gemini.integration.test.ts",
    "test:integration:ai:ollama": "vitest run --config vitest.integration.config.ts test/integration/ai-ollama.integration.test.ts",
    "verify:browser": "node test/browser/run.mjs",
    "test:smoke:production": "node test/smoke/production.mjs",
    "screenshots": "node test/browser/screenshots.mjs"
  },
  "overrides": {
    "valibot": "^1.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "5.24.0",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-map-gl": "^8.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
