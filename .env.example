# Roamly — every variable below is OPTIONAL.
#
# A fresh clone runs with this file absent: the map renders, place discovery and
# routing work against free public services, and trip generation falls back to
# the deterministic demo planner. Nothing here is required to build or deploy.
#
# Copy to `.env.local` and fill in only what you want. Never commit `.env.local`.

# ---------------------------------------------------------------------------
# AI provider selection
# ---------------------------------------------------------------------------
# auto (default) | gemini | ollama | deterministic
#
#   auto          Gemini if GEMINI_API_KEY is set, else Ollama if OLLAMA_BASE_URL
#                 is set, else the deterministic demo planner.
#   gemini        Require Gemini. Reports "not configured" without a key.
#   ollama        Require Ollama. Reports "not configured" without a base URL.
#   deterministic Never call a model, even when one is configured.
ROAMLY_AI_PROVIDER=auto

# ---------------------------------------------------------------------------
# Google Gemini — free tier available, rate limits apply
# https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Default: gemini-2.5-flash
GEMINI_MODEL=
# Override the API host. For local fixture servers in verification runs only.
GEMINI_BASE_URL=

# ---------------------------------------------------------------------------
# Ollama — fully local, no account, no key
# https://ollama.com  ·  e.g. `ollama pull qwen3:8b`
# ---------------------------------------------------------------------------
# Setting this is what makes Ollama eligible under ROAMLY_AI_PROVIDER=auto.
# Nothing probes Ollama unless it is configured here or selected explicitly.
OLLAMA_BASE_URL=
# Default: qwen3:8b
OLLAMA_MODEL=

# ---------------------------------------------------------------------------
# Identifying yourself to the free providers (fair use) — SET THIS
# ---------------------------------------------------------------------------
# Sent in the outbound User-Agent to Nominatim, Overpass and Wikimedia, and on
# routing requests, so an operator can see who is calling and get in touch. Set
# it to your own project or contact URL before deploying anything that carries
# real traffic.
#
# It must be a PUBLIC https: URL. Wikimedia requires a descriptive User-Agent
# carrying contact information and answers HTTP 403 without one, so an http:
# URL, `localhost`, or a bare email address is refused locally — and landmark
# enrichment then answers 503 rather than degrading quietly.
#
# Unset is fine for local development: a project default is substituted.
ROAMLY_CONTACT_URL=
ROAMLY_ROUTING_CLIENT_ID=

# ---------------------------------------------------------------------------
# Free public providers — override to self-host or to point at a paid service
# ---------------------------------------------------------------------------
# All three default to the free public endpoints. Those are demo-grade: strict
# fair-use pacing applies, they can be slow or unavailable, and none of them
# guarantees availability. See README → "Public-provider limitations".
#
# Nominatim — destination geocoding. Default: https://nominatim.openstreetmap.org
ROAMLY_NOMINATIM_BASE_URL=
# Overpass — place discovery. Default: https://overpass-api.de/api/interpreter
ROAMLY_OVERPASS_BASE_URL=
# Valhalla — walking, driving and cycling routes. Default: the public demo server.
ROAMLY_VALHALLA_BASE_URL=

# ---------------------------------------------------------------------------
# Wikidata and Wikimedia Commons — landmark enrichment
# ---------------------------------------------------------------------------
# NO CREDENTIAL OF ANY KIND. Every endpoint is anonymous and public, which is why
# landmark enrichment works on a fresh clone. There is no API key, token or
# client id to configure — if you find yourself looking for one, there isn't one.
#
# The only thing that matters for production is ROAMLY_CONTACT_URL above.
#
# Enrichment never runs on its own: no request on landing, during generation, or
# when a saved trip is opened. A traveller presses a control, or nothing happens.
# See docs/PLACE_INTELLIGENCE.md.
#
# The five overrides below exist so the test suites can point at local fixture
# servers. Leave them unset in development and in production — unset means the
# official Wikimedia endpoints.
ROAMLY_WIKIDATA_ENTITY_BASE_URL=
ROAMLY_WIKIDATA_API_URL=
ROAMLY_WIKIDATA_SPARQL_URL=
ROAMLY_COMMONS_API_URL=
# `{lang}` is substituted with the article's language code.
ROAMLY_WIKIPEDIA_API_URL_TEMPLATE=

# ---------------------------------------------------------------------------
# Test infrastructure — NEVER set these anywhere you serve traffic
# ---------------------------------------------------------------------------
# Deliberately listed as names only, with no assignments. They are set by
# `test/browser/run.mjs` and by unit tests, and by nothing else.
#
# They cannot activate in a served application: the gate in
# lib/place-intelligence/fixture-origin.ts additionally requires
# NODE_ENV === "development" (next build and next start both report
# "production"), the absence of every deployment marker (VERCEL, VERCEL_ENV,
# AWS_LAMBDA_FUNCTION_NAME, …), a loopback origin with an explicit port, and
# every one of the five Wikimedia endpoints above redirected onto that origin.
# The NEXT_PUBLIC_ pair additionally requires the page's own hostname to be
# loopback, read from window.location — which no deployment can satisfy.
#
# They are named here so that finding one set in a real environment is
# recognisable as a mistake rather than a mystery. See docs/LAUNCH_CHECKLIST.md.
#
#   ROAMLY_BROWSER_FIXTURE_RUN              the browser-harness opt-in
#   ROAMLY_WIKIMEDIA_FIXTURE_MODE           the second opt-in, required with it
#   ROAMLY_WIKIMEDIA_FIXTURE_ORIGIN         the one loopback origin permitted
#   ROAMLY_ENRICHMENT_BUDGET_MS             shortens the server budget (max 30s)
#   ROAMLY_WIKIMEDIA_CACHE_DISABLED         bypasses cache READS only
#   NEXT_PUBLIC_ROAMLY_WIKIMEDIA_FIXTURE_MODE
#   NEXT_PUBLIC_ROAMLY_WIKIMEDIA_FIXTURE_ORIGIN

# ---------------------------------------------------------------------------
# Public browser configuration — never secrets
# ---------------------------------------------------------------------------
# Both are NEXT_PUBLIC_ deliberately: the browser needs them, and both are
# values you are willing to publish. Never put a token in either.
#
# The canonical origin, for canonical tags and the social-preview URL.
# Falls back to the production host; set it on preview deployments.
NEXT_PUBLIC_SITE_URL=
# A vector-tile style URL. Default: OpenFreeMap positron (community-funded,
# appropriate for light portfolio use only). A provider that requires a secret
# token needs a server-side proxy, not this variable.
NEXT_PUBLIC_BASEMAP_STYLE_URL=
